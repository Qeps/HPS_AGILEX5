# --- Quartus / Intel FPGA temporary files ---
db/
incremental_db/
qdb/
tmp/
*.done
*.jdi
*.pin
*.sld
*.summary
*.qws

# --- Project specific generated files ---
# We don't ignore the whole output_files/ directory 
# because we want to keep scripts (.sh) and README.md.
# Instead, we ignore large binaries and logs inside it.
output_files/*.sof
output_files/*.rbf
output_files/*.hex
output_files/dummy.hex
output_files/serv_req_info.txt

# --- System & Editor files ---
.DS_Store
*.swp
*~

u-boot-socfpga/
arm-trusted-firmware/

# --- Exceptions 
!output_files/terasic_official_spl.hex
!output_files/golden_top.sof
